# ---------- PostgreSQL ----------
POSTGRES_DB=repetitor
POSTGRES_USER=repetitor
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

# ---------- API ----------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
AUTO_MIGRATE=true
# Swagger UI: true для локальной разработки, false в production
SWAGGER_ENABLED=true

# ---------- Web UI ----------
WEB_PORT=8081

# ---------- JWT (обязательно: минимум 32 байта) ----------
# сгенерировать: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_at_least_32_bytes_long_random_secret
JWT_ISSUER=repetitor-api
JWT_AUDIENCE=repetitor-clients
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# ---------- CORS ----------
CORS_ORIGIN=*

# ---------- Seed администратора (необязательно) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- ИИ: провайдер по умолчанию (ollama | openai) ----------
AI_DEFAULT_PROVIDER=ollama

OPENAI_ENABLED=false
OPENAI_API_KEY=

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434/
OLLAMA_PORT=11434

# Модели Ollama. Значения должны совпадать с тегами из `ollama list`.
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
