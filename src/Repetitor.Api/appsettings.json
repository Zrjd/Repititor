        "TimeoutSeconds": 180,
        "RequestsPerMinute": 60,
        "InputCostPerMillionTokens": 0.0,
        "OutputCostPerMillionTokens": 0.0
      }
    }
  },
  "Media": {
    "RootPath": "media",
    "MaxUploadBytes": 15728640,
    "RetentionDays": 30,
    "AllowedAudioContentTypes": [
      "audio/mpeg",
      "audio/mp3",
      "audio/mp4",
      "audio/m4a",
      "audio/aac",
      "audio/wav",
      "audio/x-wav",
      "audio/ogg",
      "audio/webm",
      "audio/flac",
      "audio/3gpp",
      "application/ogg"
